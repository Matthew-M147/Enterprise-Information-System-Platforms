<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Lab_1.Pages.OrderEditPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8" MaximumWidthRequest="600" HorizontalOptions="Start">
            <Label x:Name="ErrorLabel" TextColor="#DC3545" IsVisible="False" />

            <Label Text="Клієнт" />
            <Picker x:Name="ClientPicker" Title="Оберіть клієнта" />
            <Label Text="Тур" />
            <Picker x:Name="TourPicker" Title="Оберіть тур" />
            <Label Text="Дата замовлення" />
            <DatePicker x:Name="OrderDatePicker" Format="dd.MM.yyyy" />
            <Label Text="Дата поїздки" />
            <DatePicker x:Name="TripDatePicker" Format="dd.MM.yyyy" />
            <Label Text="Кількість" />
            <Entry x:Name="QuantityEntry" Keyboard="Numeric" />
            <Label Text="Знижка, %" />
            <Entry x:Name="DiscountEntry" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="10" Margin="0,12,0,0">
                <Button Text="Зберегти" Clicked="OnSaveClicked" />
                <Button Text="Скасувати" Clicked="OnCancelClicked" BackgroundColor="Gray" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
