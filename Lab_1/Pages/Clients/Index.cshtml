@page
@model IndexModel
@{
    ViewData["Title"] = "Клієнти";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Клієнти</h1>
    <a class="btn btn-success" asp-page="Create">Додати клієнта</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>ПІБ</th>
            <th>Телефон</th>
            <th>Адреса</th>
            <th>Замовлень</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model.Clients)
        {
            <tr>
                <td>@client.Id</td>
                <td>@client.FullName</td>
                <td>@client.Phone</td>
                <td>@client.Address</td>
                <td>@client.Orders.Count</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@client.Id">Редагувати</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@client.Id">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>
