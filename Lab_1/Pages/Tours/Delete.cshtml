@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Видалення туру";
}

<h1 class="mb-3">Видалити тур?</h1>

<dl class="row">
    <dt class="col-sm-2">Назва</dt>
    <dd class="col-sm-10">@Model.Tour.Name</dd>
    <dt class="col-sm-2">Ціна</dt>
    <dd class="col-sm-10">@Model.Tour.Price.ToString("N2") грн</dd>
    <dt class="col-sm-2">Тривалість</dt>
    <dd class="col-sm-10">@Model.Tour.DurationDays дн.</dd>
    <dt class="col-sm-2">Опис</dt>
    <dd class="col-sm-10">@Model.Tour.Description</dd>
</dl>

@if (Model.Tour.Orders.Count > 0)
{
    <div class="alert alert-warning">
        Разом із туром буде видалено замовлення на нього: <strong>@Model.Tour.Orders.Count</strong>.
    </div>
}

<form method="post">
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a class="btn btn-secondary" asp-page="Index">Скасувати</a>
</form>
