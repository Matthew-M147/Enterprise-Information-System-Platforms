@page
@model IndexModel
@{
    ViewData["Title"] = "Тури";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Тури</h1>
    <a class="btn btn-success" asp-page="Create">Додати тур</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Назва</th>
            <th>Ціна, грн</th>
            <th>Днів</th>
            <th>Опис</th>
            <th>Замовлень</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tour in Model.Tours)
        {
            <tr>
                <td>@tour.Id</td>
                <td class="text-nowrap">@tour.Name</td>
                <td class="text-nowrap">@tour.Price.ToString("N2")</td>
                <td>@tour.DurationDays</td>
                <td class="small">@tour.Description</td>
                <td>@tour.Orders.Count</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@tour.Id">Редагувати</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@tour.Id">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>
