<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Lab_1.Models"
    x:Class="Lab_1.Pages.ToursPage"
    Title="Тури">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="12">
        <Button Text="Додати тур" Clicked="OnAddClicked" HorizontalOptions="Start" />

        <CollectionView x:Name="ToursView" Grid.Row="1">
            <CollectionView.EmptyView>
                <Label Text="Турів немає" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Tour">
                    <Border Padding="12" Margin="0,0,0,8" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Price, StringFormat='Ціна: {0:N2} грн'}" />
                                            <Span Text="{Binding DurationDays, StringFormat=', тривалість: {0} дн.'}" />
                                            <Span Text="{Binding Orders.Count, StringFormat=', замовлень: {0}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Редагувати" VerticalOptions="Center"
                                    Clicked="OnEditClicked" CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="Видалити" VerticalOptions="Center" BackgroundColor="#DC3545"
                                    Clicked="OnDeleteClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
