@page
@model IndexModel
@{
    ViewData["Title"] = "Замовлення";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Замовлення</h1>
    <a class="btn btn-success" asp-page="Create">Додати замовлення</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>№</th>
            <th>Клієнт</th>
            <th>Тур</th>
            <th>Дата поїздки</th>
            <th>Днів</th>
            <th>К-сть</th>
            <th>Ціна</th>
            <th>Знижка</th>
            <th>Сума</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Client.LastName @order.Client.FirstName</td>
                <td>@order.Tour.Name</td>
                <td>@order.TripDate.ToString("dd.MM.yyyy")</td>
                <td>@order.Tour.DurationDays</td>
                <td>@order.Quantity</td>
                <td class="text-nowrap">@order.Tour.Price.ToString("N2")</td>
                <td>@order.DiscountPercent.ToString("0.##")%</td>
                <td class="text-nowrap fw-semibold">@order.Total.ToString("N2")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@order.Id">Редагувати</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@order.Id">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>
