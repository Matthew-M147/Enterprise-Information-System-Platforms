@model Order

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="ClientId" class="form-label"></label>
        <select asp-for="ClientId" asp-items='(SelectList)ViewData["Clients"]!' class="form-select">
            <option value="0">— оберіть клієнта —</option>
        </select>
        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TourId" class="form-label"></label>
        <select asp-for="TourId" asp-items='(SelectList)ViewData["Tours"]!' class="form-select">
            <option value="0">— оберіть тур —</option>
        </select>
        <span asp-validation-for="TourId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="OrderDate" class="form-label"></label>
        <input asp-for="OrderDate" type="date" class="form-control" />
        <span asp-validation-for="OrderDate" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="TripDate" class="form-label"></label>
        <input asp-for="TripDate" type="date" class="form-control" />
        <span asp-validation-for="TripDate" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DiscountPercent" class="form-label"></label>
        <input asp-for="DiscountPercent" class="form-control" step="0.01" />
        <span asp-validation-for="DiscountPercent" class="text-danger"></span>
    </div>
</div>
