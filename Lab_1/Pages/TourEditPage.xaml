<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Lab_1.Pages.TourEditPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8" MaximumWidthRequest="600" HorizontalOptions="Start">
            <Label x:Name="ErrorLabel" TextColor="#DC3545" IsVisible="False" />

            <Label Text="Назва" />
            <Entry x:Name="NameEntry" />
            <Label Text="Ціна, грн" />
            <Entry x:Name="PriceEntry" Keyboard="Numeric" />
            <Label Text="Тривалість, днів" />
            <Entry x:Name="DurationEntry" Keyboard="Numeric" />
            <Label Text="Опис" />
            <Editor x:Name="DescriptionEditor" HeightRequest="100" AutoSize="TextChanges" />

            <HorizontalStackLayout Spacing="10" Margin="0,12,0,0">
                <Button Text="Зберегти" Clicked="OnSaveClicked" />
                <Button Text="Скасувати" Clicked="OnCancelClicked" BackgroundColor="Gray" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
