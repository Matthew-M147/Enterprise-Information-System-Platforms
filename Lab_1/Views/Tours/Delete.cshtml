@model Tour
@{
    ViewData["Title"] = "Видалення туру";
}

<h1 class="mb-3">Видалити тур?</h1>

<dl class="row">
    <dt class="col-sm-2">Назва</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Ціна</dt>
    <dd class="col-sm-10">@Model.Price.ToString("N2") грн</dd>
    <dt class="col-sm-2">Тривалість</dt>
    <dd class="col-sm-10">@Model.DurationDays дн.</dd>
    <dt class="col-sm-2">Опис</dt>
    <dd class="col-sm-10">@Model.Description</dd>
</dl>

@if (Model.Orders.Count > 0)
{
    <div class="alert alert-warning">
        Разом із туром буде видалено замовлення на нього: <strong>@Model.Orders.Count</strong>.
    </div>
}

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a class="btn btn-secondary" asp-action="Index">Скасувати</a>
</form>
