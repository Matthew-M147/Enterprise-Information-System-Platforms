@model Client
@{
    ViewData["Title"] = "Видалення клієнта";
}

<h1 class="mb-3">Видалити клієнта?</h1>

<dl class="row">
    <dt class="col-sm-2">ПІБ</dt>
    <dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Телефон</dt>
    <dd class="col-sm-10">@Model.Phone</dd>
    <dt class="col-sm-2">Адреса</dt>
    <dd class="col-sm-10">@Model.Address</dd>
</dl>

@if (Model.Orders.Count > 0)
{
    <div class="alert alert-warning">
        Разом із клієнтом буде видалено його замовлення: <strong>@Model.Orders.Count</strong>.
    </div>
}

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a class="btn btn-secondary" asp-action="Index">Скасувати</a>
</form>
