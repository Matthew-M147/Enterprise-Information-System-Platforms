<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Туристична фірма</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Туристична фірма</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Clients" asp-action="Index">Клієнти</a>
                <a class="nav-link" asp-controller="Tours" asp-action="Index">Тури</a>
                <a class="nav-link" asp-controller="Orders" asp-action="Index">Замовлення</a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>
</body>
</html>
