@model Order
@{
    ViewData["Title"] = "Видалення замовлення";
}

<h1 class="mb-3">Видалити замовлення №@Model.Id?</h1>

<dl class="row">
    <dt class="col-sm-2">Клієнт</dt>
    <dd class="col-sm-10">@Model.Client.FullName</dd>
    <dt class="col-sm-2">Тур</dt>
    <dd class="col-sm-10">@Model.Tour.Name</dd>
    <dt class="col-sm-2">Дата поїздки</dt>
    <dd class="col-sm-10">@Model.TripDate.ToString("dd.MM.yyyy")</dd>
    <dt class="col-sm-2">Кількість</dt>
    <dd class="col-sm-10">@Model.Quantity</dd>
    <dt class="col-sm-2">Сума</dt>
    <dd class="col-sm-10">@Model.Total.ToString("N2") грн</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a class="btn btn-secondary" asp-action="Index">Скасувати</a>
</form>
