@{
    ViewData["Title"] = "Головна";
}

<h1 class="mb-3">Туристична фірма</h1>
<p class="text-muted mb-4">Облік клієнтів, турів і замовлень (ASP.NET Core MVC + Entity Framework Core + PostgreSQL).</p>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Клієнти</h5>
                <p class="display-6">@ViewBag.ClientsCount</p>
                <a class="btn btn-primary" asp-controller="Clients" asp-action="Index">Перейти</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Тури</h5>
                <p class="display-6">@ViewBag.ToursCount</p>
                <a class="btn btn-primary" asp-controller="Tours" asp-action="Index">Перейти</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Замовлення</h5>
                <p class="display-6">@ViewBag.OrdersCount</p>
                <a class="btn btn-primary" asp-controller="Orders" asp-action="Index">Перейти</a>
            </div>
        </div>
    </div>
</div>
