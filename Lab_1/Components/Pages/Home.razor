@page "/"
@inject IDbContextFactory<TravelAgencyContext> DbFactory

<PageTitle>Головна — Туристична фірма</PageTitle>

<h1 class="mb-3">Туристична фірма</h1>
<p class="text-muted mb-4">Облік клієнтів, турів і замовлень (Blazor + Entity Framework Core + PostgreSQL).</p>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Клієнти</h5>
                <p class="display-6">@clientsCount</p>
                <a class="btn btn-primary" href="clients">Перейти</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Тури</h5>
                <p class="display-6">@toursCount</p>
                <a class="btn btn-primary" href="tours">Перейти</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Замовлення</h5>
                <p class="display-6">@ordersCount</p>
                <a class="btn btn-primary" href="orders">Перейти</a>
            </div>
        </div>
    </div>
</div>

@code {
    private int clientsCount;
    private int toursCount;
    private int ordersCount;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        clientsCount = await db.Clients.CountAsync();
        toursCount = await db.Tours.CountAsync();
        ordersCount = await db.Orders.CountAsync();
    }
}
