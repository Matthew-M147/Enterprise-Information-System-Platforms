@page "/orders/create"
@page "/orders/edit/{Id:int}"
@inject IDbContextFactory<TravelAgencyContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@Title — Туристична фірма</PageTitle>

<h1 class="mb-3">@Title</h1>

@if (!loaded)
{
    <p>Завантаження...</p>
}
else if (order == null)
{
    <div class="alert alert-warning">Замовлення не знайдено.</div>
    <a class="btn btn-secondary" href="orders">Назад</a>
}
else
{
    <EditForm Model="order" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        @if (error != null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Клієнт</label>
                <InputSelect @bind-Value="order.ClientId" class="form-select">
                    <option value="0">— оберіть клієнта —</option>
                    @foreach (var client in clients)
                    {
                        <option value="@client.Id">@client.FullName</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => order.ClientId" class="text-danger" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Тур</label>
                <InputSelect @bind-Value="order.TourId" class="form-select">
                    <option value="0">— оберіть тур —</option>
                    @foreach (var tour in tours)
                    {
                        <option value="@tour.Id">@tour.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => order.TourId" class="text-danger" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Дата замовлення</label>
                <InputDate @bind-Value="order.OrderDate" class="form-control" />
                <ValidationMessage For="() => order.OrderDate" class="text-danger" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Дата поїздки</label>
                <InputDate @bind-Value="order.TripDate" class="form-control" />
                <ValidationMessage For="() => order.TripDate" class="text-danger" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Кількість</label>
                <InputNumber @bind-Value="order.Quantity" class="form-control" />
                <ValidationMessage For="() => order.Quantity" class="text-danger" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Знижка, %</label>
                <InputNumber @bind-Value="order.DiscountPercent" class="form-control" step="0.01" />
                <ValidationMessage For="() => order.DiscountPercent" class="text-danger" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Зберегти</button>
            <a class="btn btn-secondary" href="orders">Скасувати</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private Order? order;
    private List<Client> clients = new();
    private List<Tour> tours = new();
    private bool loaded;
    private string? error;

    private string Title => Id == null ? "Нове замовлення" : $"Редагування замовлення №{Id}";

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        clients = await db.Clients.OrderBy(c => c.LastName).AsNoTracking().ToListAsync();
        tours = await db.Tours.OrderBy(t => t.Name).AsNoTracking().ToListAsync();

        if (Id == null)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            order = new Order { OrderDate = today, TripDate = today, Quantity = 1 };
        }
        else
        {
            order = await db.Orders.FindAsync(Id.Value);
        }
        loaded = true;
    }

    private async Task SaveAsync()
    {
        if (order!.TripDate < order.OrderDate)
        {
            error = "Дата поїздки не може бути раніше дати замовлення";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (Id == null)
            db.Orders.Add(order);
        else
            db.Orders.Update(order);

        await db.SaveChangesAsync();
        Navigation.NavigateTo("orders");
    }
}
