@page "/clients"
@inject IDbContextFactory<TravelAgencyContext> DbFactory

<PageTitle>Клієнти — Туристична фірма</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Клієнти</h1>
    <a class="btn btn-success" href="clients/create">Додати клієнта</a>
</div>

@if (clients == null)
{
    <p>Завантаження...</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>ПІБ</th>
                <th>Телефон</th>
                <th>Адреса</th>
                <th>Замовлень</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.FullName</td>
                    <td>@client.Phone</td>
                    <td>@client.Address</td>
                    <td>@client.Orders.Count</td>
                    <td class="text-end text-nowrap">
                        @if (deletingId == client.Id)
                        {
                            <span class="me-2">
                                @(client.Orders.Count > 0 ? $"Видалити разом із замовленнями ({client.Orders.Count})?" : "Видалити?")
                            </span>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(client.Id)">Так</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => deletingId = null">Ні</button>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary" href="clients/edit/@client.Id">Редагувати</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => deletingId = client.Id">Видалити</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Client>? clients;
    private int? deletingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        clients = await db.Clients
            .Include(c => c.Orders)
            .OrderBy(c => c.Id)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task DeleteAsync(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var client = await db.Clients
            .Include(c => c.Orders)
            .FirstOrDefaultAsync(c => c.Id == id);
        if (client != null)
        {
            db.Clients.Remove(client);
            await db.SaveChangesAsync();
        }

        deletingId = null;
        await LoadAsync();
    }
}
