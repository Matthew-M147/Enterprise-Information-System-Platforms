@page "/clients/create"
@page "/clients/edit/{Id:int}"
@inject IDbContextFactory<TravelAgencyContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@Title — Туристична фірма</PageTitle>

<h1 class="mb-3">@Title</h1>

@if (!loaded)
{
    <p>Завантаження...</p>
}
else if (client == null)
{
    <div class="alert alert-warning">Клієнта не знайдено.</div>
    <a class="btn btn-secondary" href="clients">Назад</a>
}
else
{
    <EditForm Model="client" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        @if (error != null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Прізвище</label>
                <InputText @bind-Value="client.LastName" class="form-control" />
                <ValidationMessage For="() => client.LastName" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Ім'я</label>
                <InputText @bind-Value="client.FirstName" class="form-control" />
                <ValidationMessage For="() => client.FirstName" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label">По батькові</label>
                <InputText @bind-Value="client.MiddleName" class="form-control" />
                <ValidationMessage For="() => client.MiddleName" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Телефон</label>
                <InputText @bind-Value="client.Phone" class="form-control" placeholder="+380..." />
                <ValidationMessage For="() => client.Phone" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Місто</label>
                <InputText @bind-Value="client.City" class="form-control" />
                <ValidationMessage For="() => client.City" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Вулиця</label>
                <InputText @bind-Value="client.Street" class="form-control" />
                <ValidationMessage For="() => client.Street" class="text-danger" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Будинок</label>
                <InputText @bind-Value="client.Building" class="form-control" />
                <ValidationMessage For="() => client.Building" class="text-danger" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Квартира</label>
                <InputText @bind-Value="client.Apartment" class="form-control" />
                <ValidationMessage For="() => client.Apartment" class="text-danger" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Зберегти</button>
            <a class="btn btn-secondary" href="clients">Скасувати</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private Client? client;
    private bool loaded;
    private string? error;

    private string Title => Id == null ? "Новий клієнт" : "Редагування клієнта";

    protected override async Task OnParametersSetAsync()
    {
        if (Id == null)
        {
            client = new Client();
        }
        else
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            client = await db.Clients.FindAsync(Id.Value);
        }
        loaded = true;
    }

    private async Task SaveAsync()
    {
        client!.MiddleName = string.IsNullOrWhiteSpace(client.MiddleName) ? null : client.MiddleName;
        client.Apartment = string.IsNullOrWhiteSpace(client.Apartment) ? null : client.Apartment;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Clients.AnyAsync(c => c.Phone == client!.Phone && c.Id != client.Id))
        {
            error = "Клієнт з таким телефоном вже існує";
            return;
        }

        if (Id == null)
            db.Clients.Add(client!);
        else
            db.Clients.Update(client!);

        await db.SaveChangesAsync();
        Navigation.NavigateTo("clients");
    }
}
